APP_NAME="Software Factory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (Laravel Sail MySQL) -------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=software_factory
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Sail
APP_PORT=80
VITE_PORT=5173
WWWUSER=1000
WWWGROUP=1000

# --- Software Factory ---------------------------------------------------------
# docker = run install/test commands in throw-away containers (needs the docker socket,
#          which compose.yaml mounts). fake = simulate results (offline demo / CI).
FACTORY_EXECUTOR=docker

# Strongly recommended: HTTP Basic password protecting the whole dashboard (any username).
FACTORY_ACCESS_PASSWORD=

FACTORY_DEFAULT_BUDGET_USD=25
FACTORY_BUDGET_RAISE_USD=25
FACTORY_MAX_GREEN_ATTEMPTS=4
FACTORY_CONTAINER_TIMEOUT=900
FACTORY_CONTAINER_MEMORY=2g
FACTORY_CONTAINER_CPUS=2
FACTORY_CONTAINER_NETWORK=bridge

# Image used to run this app's own test-suite during self-iteration
FACTORY_SELF_IMAGE=sail-8.5/app

# --- AI providers (leave blank to use the built-in offline "fake" model) ------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
